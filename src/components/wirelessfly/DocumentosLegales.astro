---
const documentos = [
  {
    titulo: "Título de Concesión IFT",
    descripcion: "Autorización oficial para operar servicios de telecomunicaciones.",
    archivo: "/docs/TITULO-DE-CONCESION-IFT.pdf",
  },
  {
    titulo: "Contrato de Adhesión",
    descripcion: "Contrato registrado y aprobado por IFT y PROFECO.",
    archivo: "/docs/CONTRATO-DE-ADHESION.pdf",
  },
  {
    titulo: "Código de Prácticas Comerciales",
    descripcion: "Lineamientos sobre la prestación y comercialización del servicio.",
    archivo: "/docs/CODIGO-DE-PRACTICAS.pdf",
  },
  {
    titulo: "Carta de Derechos del Usuario",
    descripcion: "Derechos del consumidor de servicios de telecomunicaciones.",
    archivo: "/docs/CARTA-DE-DERECHOS.pdf",
  },
  {
    titulo: "Aviso de Privacidad",
    descripcion: "Protección y uso responsable de los datos personales.",
    archivo: "/docs/AVISO-DE-PRIVACIDAD.pdf",
  },
];
---

<section id="documentos-legales" class="legal-section">
  <div class="container">
    <header class="header">
      <h2 class="text-blue-900">Documentos Legales</h2>
      <p class="text-gray-700">
        Wireless Fly opera bajo las disposiciones oficiales del IFT y PROFECO,
        garantizando transparencia y confianza para nuestros clientes.
      </p>
    </header>

    <div class="grid">
      {documentos.map(doc => (
        <article class="card">
          <div class="icon">📄</div>
          <h3>{doc.titulo}</h3>
          <p>{doc.descripcion}</p>
          <a href={doc.archivo} target="_blank" rel="noopener">
            Ver documento
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.legal-section {
  padding: 6rem 1.5rem;
  background-color: #DDF4E7;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.header {
  text-align: center;
  margin-bottom: 4rem;
}

.header h2 {
  font-size: 2.5rem;
  font-weight: 700;
}

.header p {
  max-width: 720px;
  margin: 1rem auto 0;
  font-size: 1.1rem;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 2rem;
}

.card {
  background: #ffffff;
  border-radius: 18px;
  padding: 2.2rem;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  transition: transform 0.35s ease, box-shadow 0.35s ease;
  text-align: center;
}

.card:hover {
  transform: translateY(-6px);
  box-shadow: 0 18px 45px rgba(0,0,0,0.12);
}

.icon {
  font-size: 2.6rem;
  margin-bottom: 1rem;
}

.card h3 {
  font-size: 1.15rem;
  margin-bottom: 0.5rem;
  color: #0f2a44;
}

.card p {
  font-size: 0.95rem;
  color: #5a6f78;
  margin-bottom: 1.6rem;
}

.card a {
  display: inline-block;
  padding: 0.6rem 1.6rem;
  border-radius: 999px;
  background: #0f2a44;
  color: #ffffff;
  text-decoration: none;
  font-weight: 500;
  transition: background 0.3s ease, color 0.3s ease;
}

.card a:hover {
  background: #9adcc4;
  color: #0f2a44;
}
</style>
